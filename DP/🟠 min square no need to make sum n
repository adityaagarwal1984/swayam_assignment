class Solution {
    public int numSquares(int n) {
        int arr[]= new int[n+1];
        for(int i=1;i*i<=n;i++)
        {
            arr[i*i]=1;
        }
        for(int i=2;i<=n;i++)
        {
            if(arr[i]!=1)
            arr[i]=i;
        }
        for(int i=2;i<=n;i++)
        {
            int min=arr[i];
            for(int j=i-1;j>0;j--)
            {
                int need=arr[j]+arr[i-j];
               
                min=Math.min(min,need);
            }
            arr[i]=min;
        }
        return arr[n];
    }
}
