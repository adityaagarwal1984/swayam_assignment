class Solution {
    public int countSubstrings(String s) {
        int l= s.length();
        int dp[][]= new int[l][l];
        for(int i=0;i<l;i++)
        {
            dp[i][i]=1;
        }
        for(int i=0;i<l-1;i++)
        {
            if(s.charAt(i)==s.charAt(i+1))
            dp[i][i+1]=1;
        }
        int len=3;
        while(len<=l)
        {
            for(int i=0;i<l-len+1;i++)
            {
                int x= i;
                int y= i+len-1;
                if(s.charAt(i)== s.charAt(i+len-1) && dp[x+1][y-1]==1)
                dp[x][y]=1;
            }
            len++;
        }
        int c=0;
        for(int i=0;i<l;i++)
        {
            for(int j=0;j<l;j++)
            {
                if(dp[i][j]==1) c++;
            }
        }
        return c;
    }
    
}
