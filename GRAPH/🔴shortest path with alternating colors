import java.util.*;

class Solution {
    public int[] shortestAlternatingPaths(int n, int[][] redEdges, int[][] blueEdges) {
        // Build adjacency lists separately or with color identifiers (0 = RED, 1 = BLUE)
        List<List<int[]>> graph = new ArrayList<>();
        for (int i = 0; i < n; i++) {
            graph.add(new ArrayList<>());
        }
        
        for (int[] edge : redEdges) {
            graph.get(edge[0]).add(new int[]{edge[1], 0}); // 0 for RED
        }
        for (int[] edge : blueEdges) {
            graph.get(edge[0]).add(new int[]{edge[1], 1}); // 1 for BLUE
        }

        int[] result = new int[n];
        Arrays.fill(result, -1);

        // visited[node][color]: tracks if we reached 'node' via 'color' edge
        boolean[][] visited = new boolean[n][2];

        // Queue elements: {node, current_distance, color_of_last_edge}
        // Use -1 for initial state so ANY color edge can be taken first
        Queue<int[]> queue = new LinkedList<>();
        queue.offer(new int[]{0, 0, -1});

        while (!queue.isEmpty()) {
            int[] curr = queue.poll();
            int u = curr[0];
            int dist = curr[1];
            int lastColor = curr[2];

            // Set result for node u if it hasn't been set yet (first reach is shortest in BFS)
            if (result[u] == -1) {
                result[u] = dist;
            }

            for (int[] neighbor : graph.get(u)) {
                int v = neighbor[0];
                int edgeColor = neighbor[1];

                // Alternate colors AND ensure we haven't visited node 'v' via 'edgeColor'
                if (edgeColor != lastColor && !visited[v][edgeColor]) {
                    visited[v][edgeColor] = true;
                    queue.offer(new int[]{v, dist + 1, edgeColor});
                }
            }
        }

        return result;
    }
}
