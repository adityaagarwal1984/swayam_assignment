import java.util.ArrayDeque;
import java.util.Queue;

class Solution {
    public int shortestPathLength(int[][] graph) {
        int n = graph.length;
        
        // Base case: A single node needs 0 edges
        if (n <= 1) {
            return 0;
        }
        
        int allVisitedMask = (1 << n) - 1; // e.g., for n=4 -> 1111 (binary) = 15
        
        // Queue elements: int[] { currentNode, visitedMask, currentDistance }
        Queue<int[]> queue = new ArrayDeque<>();
        
        // visited[node][mask] prevents revisiting the exact same state at >= distance
        boolean[][] visited = new boolean[n][1 << n];
        
        // Multi-source initialization: Start BFS from every node simultaneously
        for (int i = 0; i < n; i++) {
            int initialMask = 1 << i;
            queue.offer(new int[]{i, initialMask, 0});
            visited[i][initialMask] = true;
        }
        
        while (!queue.isEmpty()) {
            int[] current = queue.poll();
            int u = current[0];
            int mask = current[1];
            int dist = current[2];
            
            // Check if all nodes have been visited
            if (mask == allVisitedMask) {
                return dist;
            }
            
            // Explore all adjacent neighbors in the original graph
            for (int v : graph[u]) {
                int nextMask = mask | (1 << v);
                
                // Only push if this (neighbor, newMask) state hasn't been visited yet
                if (!visited[v][nextMask]) {
                    visited[v][nextMask] = true;
                    queue.offer(new int[]{v, nextMask, dist + 1});
                }
            }
        }
        
        return -1; // Unreachable (graph is guaranteed connected)
    }
}
