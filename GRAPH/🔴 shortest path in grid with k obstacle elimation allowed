class Solution {
    public int shortestPath(int[][] grid, int k) {
        int m = grid.length, n = grid[0].length;
        
        // Shortcut: If k is large enough, just return Manhattan distance
        if (k >= m + n - 2) return m + n - 2;

        // Queue stores: {row, col, remaining_k}
        Queue<int[]> queue = new LinkedList<>();
        
        // visited[r][c] stores max remaining k encountered at (r, c)
        int[][] visited = new int[m][n];
        for (int[] row : visited) Arrays.fill(row, -1);

        queue.offer(new int[]{0, 0, k});
        visited[0][0] = k;

        int steps = 0;
        int[][] dirs = {{0, 1}, {1, 0}, {0, -1}, {-1, 0}};

        while (!queue.isEmpty()) {
            int size = queue.size();
            
            for (int i = 0; i < size; i++) {
                int[] curr = queue.poll();
                int r = curr[0], c = curr[1], remK = curr[2];

                if (r == m - 1 && c == n - 1) return steps;

                for (int[] d : dirs) {
                    int nr = r + d[0], nc = c + d[1];

                    if (nr >= 0 && nr < m && nc >= 0 && nc < n) {
                        int nextK = remK - grid[nr][nc];

                        // Can only move if we have enough k AND it's a better state
                        if (nextK >= 0 && nextK > visited[nr][nc]) {
                            visited[nr][nc] = nextK;
                            queue.offer(new int[]{nr, nc, nextK});
                        }
                    }
                }
            }
            steps++;
        }

        return -1;
    }
}
